{
  "name": "@goopil/clusterkit",
  "version": "2.2.1",
  "description": "Zero-dependency Node.js cluster orchestrator for containers: SO_REUSEPORT detection, graceful shutdown with ACK protocol, crash circuit breaker, worker recycling and cgroup-aware sizing.",
  "keywords": [
    "cluster",
    "worker",
    "orchestrator",
    "docker",
    "kubernetes",
    "cgroup",
    "so-reuseport",
    "so_reuseport",
    "graceful-shutdown",
    "circuit-breaker",
    "process-manager",
    "multi-core",
    "load-balancing",
    "zero-downtime",
    "pm2-alternative",
    "web-concurrency",
    "http-server"
  ],
  "homepage": "https://github.com/Goopil/clusterkit#readme",
  "bugs": {
    "url": "https://github.com/Goopil/clusterkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goopil/clusterkit.git",
    "directory": "packages/worker-manager"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
