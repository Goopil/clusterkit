{
  "name": "clusterkit",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Node.js cluster orchestrator for containers: SO_REUSEPORT detection, graceful shutdown, crash circuit breaker, worker recycling and cgroup-aware sizing.",
  "keywords": [
    "cluster",
    "worker",
    "orchestrator",
    "so-reuseport",
    "kubernetes",
    "docker",
    "graceful-shutdown",
    "circuit-breaker",
    "process-manager",
    "nodejs"
  ],
  "author": "Goopil <https://github.com/Goopil>",
  "homepage": "https://github.com/Goopil/clusterkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goopil/clusterkit.git"
  },
  "bugs": {
    "url": "https://github.com/Goopil/clusterkit/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "serve": "turbo run serve",
    "test": "turbo run test --filter=./packages/**",
    "test:smoke": "vitest run --root examples",
    "test:coverage": "turbo run test:coverage --filter=./packages/**",
    "test:packages": "node scripts/package-smoke-test.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:linux": "docker compose run --build --rm test",
    "examples:start": "docker compose up examples --build",
    "bench": "pnpm --filter benchmarks exec node runner.mjs",
    "bench:docker": "docker compose -f benchmarks/docker-compose.bench.yml run --build --rm benchmark",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "ci:publish": "pnpm build && node scripts/publish-with-oidc.mjs && changeset tag"
  },
  "license": "LGPL-3.0-or-later",
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "publint": "^0.3.24",
    "turbo": "^2.10.12",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.18.0",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "js-yaml@>=4.0.0 <4.2.0": ">=4.2.0",
      "uuid@>=8.0.0 <11.1.1": ">=11.1.1"
    }
  }
}
